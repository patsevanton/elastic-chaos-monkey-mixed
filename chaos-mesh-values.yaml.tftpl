chaosDaemon:
  runtime: containerd
  socketPath: /run/containerd/containerd.sock
controllerManager:
  replicaCount: 3
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 128Mi
dashboard:
  rootUrl: http://chaos-dashboard.${ingress_ip}.sslip.io
  ingress:
    enabled: true
    apiVersionOverrides: networking.k8s.io/v1
    ingressClassName: traefik
    annotations:
      traefik.ingress.kubernetes.io/router.entrypoints: public
    hosts:
      - name: chaos-dashboard.${ingress_ip}.sslip.io
