            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(elasticsearch_indices_indexing_index_total{cluster=\"elastic\"}[5m]))"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 35
          }
        },
        {
          "title": "unassigned / initializing / relocating shards",
          "description": "Число шардов в состояниях unassigned (не размещены), initializing (инициализируются) и relocating (переезжают). Unassigned > 0 при достаточных нодах — признак потери связи с нодой или нехватки места.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(elasticsearch_cluster_health_unassigned_shards{cluster=\"elastic\"})",
              "legendFormat": "unassigned"
            },
            {
              "refId": "B",
              "expr": "sum(elasticsearch_cluster_health_initializing_shards{cluster=\"elastic\"})",
              "legendFormat": "initializing"
            },
            {
              "refId": "C",
              "expr": "sum(elasticsearch_cluster_health_relocating_shards{cluster=\"elastic\"})",
              "legendFormat": "relocating"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 43
          }
        }
      ],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      }
    },
    {
      "type": "row",
      "title": "Отбои и очереди (потери/задержки для приложения)",
      "collapsed": false,
      "panels": [
        {
          "title": "thread pool: rejections (ops/s)",
          "description": "Скорость отказов пулов потоков Elasticsearch (indexing/search/write и т.д.) в операциях в секунду. Любые ненулевые значения означают переполнение очередей и отбрасывание запросов.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (type) (rate(elasticsearch_thread_pool_rejected_count{cluster=\"elastic\"}[5m]) > 0)"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 52
          }
        },
        {
          "title": "thread pool: в очереди (по пулам indexing/search)",
          "description": "Текущая длина очередей пулов потоков поиска и записи. Рост очереди предшествует отказам (rejections) и росту задержек.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (type) (elasticsearch_thread_pool_queue_count{cluster=\"elastic\", type=~\"search|write|index\"})"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 52
          }
        },
        {
          "title": "pending tasks (master queue)",
          "description": "Число задач, ожидающих обработки мастер-нодой. Рост означает, что кластер не успевает применять изменения состояния (аллокация шардов, обновления метаданных).",
          "type": "timeseries",
          "datasource": {
