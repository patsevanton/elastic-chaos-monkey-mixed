{
  "title": "elasticsearch-cluster",
  "uid": "elasticsearch-cluster",
  "tags": [
    "elasticsearch",
    "app"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Chaos",
        "target": {
          "limit": 100,
          "matchAny": true,
          "tags": [
            "chaos",
            "sg"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Приложение (loadgen): успех/ошибки",
      "collapsed": false,
      "panels": [
        {
          "title": "bulk: ошибки и успех (docs/s)",
          "description": "Скорость обработки bulk-запросов внутри кластера в документах в секунду: кривые err и ok по метрикам loadgen. Рост err означает, что часть документов не записалась.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(loadgen_bulk_err_total{job=\"loadgen\"}[5m]))",
              "legendFormat": "err"
            },
            {
              "refId": "B",
              "expr": "sum(rate(loadgen_bulk_ok_total{job=\"loadgen\"}[5m]))",
              "legendFormat": "ok"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 1
          }
        },
        {
          "title": "bulk: доля ошибок (%)",
          "description": "Процент ошибочных bulk-запросов от общего их числа. В норме 0%; рост указывает на проблемы записи (отказы шардов, таймауты, rejections).",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "100 * sum(rate(loadgen_bulk_err_total{job=\"loadgen\"}[5m])) / clamp_min(sum(rate(loadgen_bulk_ok_total{job=\"loadgen\"}[5m])) + sum(rate(loadgen_bulk_err_total{job=\"loadgen\"}[5m])), 1e-6)"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 1
          }
        },
        {
          "title": "search: ошибки и успех (req/s)",
          "description": "Скорость поисковых запросов внутри кластера: успешные и ошибочные _search в секунду. Падение ok с ростом err — деградация чтения.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(loadgen_search_err_total{job=\"loadgen\"}[5m]))",
              "legendFormat": "err"
            },
            {
              "refId": "B",
              "expr": "sum(rate(loadgen_search_ok_total{job=\"loadgen\"}[5m]))",
              "legendFormat": "ok"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 9
          }
        },
        {
          "title": "search: доля ошибок (%)",
          "description": "Процент ошибочных поисковых запросов от общего числа. В норме 0%; рост говорит о недоступности шардов/нод или таймаутах.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "100 * sum(rate(loadgen_search_err_total{job=\"loadgen\"}[5m])) / clamp_min(sum(rate(loadgen_search_ok_total{job=\"loadgen\"}[5m])) + sum(rate(loadgen_search_err_total{job=\"loadgen\"}[5m])), 1e-6)"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 9
          }
        }
      ],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "Latency Elasticsearch (внутри кластера)",
      "collapsed": false,
      "panels": [
        {
          "title": "search: query + fetch время (s/s, по всем докам)",
          "description": "Суммарное время фазы query и фазы fetch поисковых запросов (секунды в секунду по всем документам). Рост показывает, сколько времени ES тратит на поиск и выборку.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(elasticsearch_indices_search_query_time_seconds{cluster=\"elastic\"}[5m]))",
              "legendFormat": "query"
            },
            {
              "refId": "B",
              "expr": "sum(rate(elasticsearch_indices_search_fetch_time_seconds{cluster=\"elastic\"}[5m]))",
              "legendFormat": "fetch"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 18
          }
        },
        {
          "title": "search: query + fetch время (ms/операцию)",
          "description": "Среднее время фазы query и fetch в расчёте на одну операцию поиска. Удобно для сравнения задержки поиска до и после сбоя.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ms",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "1000 * sum(rate(elasticsearch_indices_search_query_time_seconds{cluster=\"elastic\"}[5m])) / clamp_min(sum(rate(elasticsearch_indices_search_query_total{cluster=\"elastic\"}[5m])), 1e-6)",
              "legendFormat": "query ms/op"
            },
            {
              "refId": "B",
              "expr": "1000 * sum(rate(elasticsearch_indices_search_fetch_time_seconds{cluster=\"elastic\"}[5m])) / clamp_min(sum(rate(elasticsearch_indices_search_fetch_total{cluster=\"elastic\"}[5m])), 1e-6)",
              "legendFormat": "fetch ms/op"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 18
          }
        },
        {
          "title": "indexing время (ms/операцию)",
          "description": "Среднее время индексации одного документа внутри Elasticsearch. Рост указывает на замедление записи на уровне кластера (нагрузка, merge, деградация диска).",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ms",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "1000 * sum(rate(elasticsearch_indices_indexing_index_time_seconds_total{cluster=\"elastic\"}[5m])) / clamp_min(sum(rate(elasticsearch_indices_indexing_index_total{cluster=\"elastic\"}[5m])), 1e-6)",
              "legendFormat": "indexing ms/op"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 26
          }
        }
      ],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "row",
      "title": "Пропускная способность и шарды",
      "collapsed": false,
      "panels": [
        {
          "title": "search: query/fetch rate (req/s)",
          "description": "Скорость выполнения фаз query и fetch поиска в секунду. Позволяет увидеть, растёт ли нагрузка на поиск и как меняется баланс query/fetch.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(elasticsearch_indices_search_query_total{cluster=\"elastic\"}[5m]))",
              "legendFormat": "query"
            },
            {
              "refId": "B",
              "expr": "sum(rate(elasticsearch_indices_search_fetch_total{cluster=\"elastic\"}[5m]))",
              "legendFormat": "fetch"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 35
          }
        },
        {
          "title": "indexing: index rate (docs/s)",
          "description": "Скорость индексации документов кластером (документов в секунду). Резкое падение при неизменной нагрузке loadgen означает проблемы записи.",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
