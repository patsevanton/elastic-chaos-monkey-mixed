{
  "title": "elastic-loadgen-app",
  "uid": "elastic-loadgen-app",
  "tags": [
    "loadgen",
    "elasticsearch",
    "chaos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": "label_values(loadgen_bulk_ok_total, cluster)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Bulk (запись / _bulk)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Bulk error rate",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_bulk_err_total{cluster=~\"$cluster\"}[1m])) / clamp_min(sum(rate(loadgen_bulk_ok_total{cluster=~\"$cluster\"}[1m])) + sum(rate(loadgen_bulk_err_total{cluster=~\"$cluster\"}[1m])), 1e-9)",
          "legendFormat": "bulk err %",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Bulk latency (p50/p90/p99)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(loadgen_bulk_duration_seconds_bucket{cluster=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(loadgen_bulk_duration_seconds_bucket{cluster=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(loadgen_bulk_duration_seconds_bucket{cluster=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Bulk throughput",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_bulk_ok_total{cluster=~\"$cluster\"}[1m]))",
          "legendFormat": "ok",
          "refId": "A"
        },
        {
          "expr": "sum(rate(loadgen_bulk_err_total{cluster=~\"$cluster\"}[1m]))",
          "legendFormat": "err",
          "refId": "B"
        }
      ],
      "id": 4
    },
    {
      "type": "row",
      "title": "Search (чтение / _search)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Search error rate",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_search_err_total{cluster=~\"$cluster\"}[1m])) / clamp_min(sum(rate(loadgen_search_ok_total{cluster=~\"$cluster\"}[1m])) + sum(rate(loadgen_search_err_total{cluster=~\"$cluster\"}[1m])), 1e-9)",
          "legendFormat": "search err %",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Search latency (p50/p90/p99)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(loadgen_search_duration_seconds_bucket{cluster=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(loadgen_search_duration_seconds_bucket{cluster=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(loadgen_search_duration_seconds_bucket{cluster=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Search rate",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_search_ok_total{cluster=~\"$cluster\"}[1m]))",
          "legendFormat": "ok",
          "refId": "A"
        },
        {
          "expr": "sum(rate(loadgen_search_err_total{cluster=~\"$cluster\"}[1m]))",
          "legendFormat": "err",
          "refId": "B"
        }
      ],
      "id": 8
    }
  ]
}
