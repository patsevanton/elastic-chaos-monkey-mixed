{
  "title": "elastic-loadgen-app",
  "uid": "elastic-loadgen-app",
  "tags": [
    "loadgen",
    "elasticsearch",
    "chaos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Chaos",
        "target": {
          "limit": 100,
          "matchAny": true,
          "tags": [
            "chaos",
            "sg"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": "label_values(loadgen_bulk_ok_total, cluster_name)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Bulk (запись / _bulk)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Bulk error rate",
      "description": "Доля ошибок при записи через _bulk: отношение ошибочных запросов к общему числу bulk-запросов loadgen за 1 минуту. Рост графика означает, что записи в Elasticsearch падают (сетевые потери, недоступность нод, таймауты).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_bulk_err_total{cluster_name=~\"$cluster\"}[1m])) / clamp_min(sum(rate(loadgen_bulk_ok_total{cluster_name=~\"$cluster\"}[1m])) + sum(rate(loadgen_bulk_err_total{cluster_name=~\"$cluster\"}[1m])), 1e-9)",
          "legendFormat": "bulk err %",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Bulk latency (p50/p90/p99)",
      "description": "Латентность bulk-запросов loadgen (запись документов): перцентили p50/p90/p99 времени выполнения одного _bulk-запроса. Показывает, как изоляция и задержки в сети влияют на скорость записи.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(loadgen_bulk_duration_seconds_bucket{cluster_name=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(loadgen_bulk_duration_seconds_bucket{cluster_name=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(loadgen_bulk_duration_seconds_bucket{cluster_name=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Bulk throughput",
      "description": "Пропускная способность записи: количество успешных и ошибочных bulk-запросов в секунду. Снижение ok на фоне роста err — признак деградации пути записи в Elasticsearch.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_bulk_ok_total{cluster_name=~\"$cluster\"}[1m]))",
          "legendFormat": "ok",
          "refId": "A"
        },
        {
          "expr": "sum(rate(loadgen_bulk_err_total{cluster_name=~\"$cluster\"}[1m]))",
          "legendFormat": "err",
          "refId": "B"
        }
      ],
      "id": 4
    },
    {
      "type": "row",
      "title": "Search (чтение / _search)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Search error rate",
      "description": "Доля ошибок поисковых запросов loadgen: отношение ошибочных _search к общему числу поисков за 1 минуту. Рост означает недоступность или сбой чтения из Elasticsearch.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_search_err_total{cluster_name=~\"$cluster\"}[1m])) / clamp_min(sum(rate(loadgen_search_ok_total{cluster_name=~\"$cluster\"}[1m])) + sum(rate(loadgen_search_err_total{cluster_name=~\"$cluster\"}[1m])), 1e-9)",
          "legendFormat": "search err %",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Search latency (p50/p90/p99)",
      "description": "Латентность поисковых запросов loadgen: перцентили p50/p90/p99 времени _search. Показывает, как изменение сети между зонами и репликами влияет на скорость чтения.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(loadgen_search_duration_seconds_bucket{cluster_name=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(loadgen_search_duration_seconds_bucket{cluster_name=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(loadgen_search_duration_seconds_bucket{cluster_name=~\"$cluster\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Search rate",
      "description": "Интенсивность поиска: число успешных и ошибочных _search в секунду. Помогает отделить потерю запросов (падение ok) от роста ошибок.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_search_ok_total{cluster_name=~\"$cluster\"}[1m]))",
          "legendFormat": "ok",
          "refId": "A"
        },
        {
          "expr": "sum(rate(loadgen_search_err_total{cluster_name=~\"$cluster\"}[1m]))",
          "legendFormat": "err",
          "refId": "B"
        }
      ],
      "id": 8
    }
  ]
}
