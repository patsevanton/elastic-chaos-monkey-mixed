{
  "title": "es-app-view",
  "uid": "es-exporter-view",
  "tags": [
    "elasticsearch",
    "app"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Приложение (loadgen): успех/ошибки",
      "collapsed": false,
      "panels": [
        {
          "title": "bulk: ошибки и успех (docs/s)",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(loadgen_bulk_err_total{job=\"loadgen\"}[5m]))",
              "legendFormat": "err"
            },
            {
              "refId": "B",
              "expr": "sum(rate(loadgen_bulk_ok_total{job=\"loadgen\"}[5m]))",
              "legendFormat": "ok"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 1
          }
        },
        {
          "title": "bulk: доля ошибок (%)",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "fillOpacity": 10,
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "100 * sum(rate(loadgen_bulk_err_total{job=\"loadgen\"}[5m])) / clamp_min(sum(rate(loadgen_bulk_ok_total{job=\"loadgen\"}[5m])) + sum(rate(loadgen_bulk_err_total{job=\"loadgen\"}[5m])), 1e-6)"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 1
          }
        },
